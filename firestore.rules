rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // No Cloud Functions on the free Spark plan, so there are no custom
    // claims -- role is resolved by whether a doc keyed to the signed-in
    // email exists in admins/ or managers/ (managers are keyed by email as
    // their document id, so this exists() check needs no extra lookup doc).
    function signedInEmail() {
      return request.auth.token.email;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(signedInEmail()));
    }

    function isManager() {
      return request.auth != null
        && exists(/databases/$(database)/documents/managers/$(signedInEmail()));
    }

    function isOwnManagerId(managerId) {
      return request.auth != null && signedInEmail() == managerId;
    }

    function currentCycleId() {
      return get(/databases/$(database)/documents/meta/currentCycle).data.cycleId;
    }

    // managers/reportees/cycles/allocations are edited only by an admin,
    // directly from the client (no server-side validation layer without
    // Cloud Functions) -- CSV import, cycle-open, and roster edits all
    // write here under this same admin-only gate.
    match /managers/{managerId} {
      allow read: if isAdmin() || isOwnManagerId(managerId);
      allow write: if isAdmin();
    }

    match /reportees/{reporteeId} {
      allow read: if isAdmin() || isOwnManagerId(resource.data.managerId);
      allow write: if isAdmin();
    }

    match /cycles/{cycleId} {
      allow read: if isAdmin() || isManager();
      allow write: if isAdmin();

      match /allocations/{managerId} {
        // Self-reported by the manager themselves (stakeholder feedback,
        // 2026-09-21) -- not admin- or formula-set. A manager may only
        // write their own doc, and only while that cycle is still current,
        // so a closed cycle's reported totals stay fixed (same protection
        // R7/AE3 gave the old admin-set allocations).
        allow read: if isAdmin() || isOwnManagerId(managerId);
        allow write: if isOwnManagerId(managerId) && cycleId == currentCycleId();
      }
    }

    match /meta/currentCycle {
      allow read: if isAdmin() || isManager();
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // seed the first admin manually in the console
    }

    // Awards are the one collection managers write directly (R10): a
    // manager may create an award for themselves in the current cycle, and
    // read only their own; an admin reads all. No client update/delete --
    // an award is an append-only record of what already happened.
    match /awards/{awardId} {
      allow read: if isAdmin() || isOwnManagerId(resource.data.managerId);
      allow create: if isOwnManagerId(request.resource.data.managerId)
                    && request.resource.data.cycleId == currentCycleId()
                    && request.resource.data.type in ['spark', 'beacon'];
      allow update, delete: if false;
    }
  }
}
